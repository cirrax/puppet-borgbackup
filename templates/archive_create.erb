
# commands to run before backup creation:
<% @pre_commands.each do | command | -%>
<%= command %>
<% end -%>

# Backup the most important directories into an archive named after
# the machine this script is currently running on:
<% if @stdin_cmd -%>
<%= @stdin_cmd %> | \
<% end -%>
borg create                         \
<% if @create_filter != '' -%>
    --filter <%= @create_filter %>                    \
<% end -%>
<% if @create_compression !='' -%>
    --compression <%= @create_compression %>               \
<% end -%>
<% @create_options.each do | opt | -%>
    --<%= opt -%>            \
<% end -%>
<% @create_excludes.each do | exclude | -%>
    --exclude <%= exclude -%>            \
<% end -%>
                                    \
    ::'{hostname}-<%= @archive_name %>_{now:%Y-%m-%d_%H-%M}' \
<% @create_includes.each do | include | -%>
    <%= include -%>            \
<% end -%>
<% if @stdin_cmd -%>
-
<% end -%>

backup_exit=$?

if [ ${backup_exit} -ne 0 ];
then
    info "Backup Create of archive '<%= @archive_name %>' finished with exit code ${backup_exit}"
    backup_summary="${backup_summary}\n * Archive '<%= @archive_name %>' finished with exit code ${backup_exit}"
    if [ ${backup_exit} -gt ${global_exit} ]; then
      global_exit=$backup_exit
    fi
fi

# commands to run post backup creation:
<% @post_commands.each do | command | -%>
<%= command %>
<% end -%>
